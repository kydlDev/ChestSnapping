{
  "name": "stack-survives",
  "description": "A chest really placed on a chest keeps its building support and is NOT destroyed by the game (vanilla destroys it: a chest gives no support). Control: with [Stacking] off the same placement collapses.",
  "timeout": 120,
  "steps": [
    { "do": "hook", "name": "chestsnapping.arena", "contains": "arena at", "label": "start on the arena spot" },
    { "do": "use", "block": "clearSite" },
    { "do": "spawn", "prefab": "piece_chest_wood", "dz": 3, "owner": "me", "as": "lowerA" },
    { "do": "spawn", "prefab": "piece_chest_wood", "dx": 6, "dz": 3, "owner": "me", "as": "lowerB" },
    { "do": "hook", "name": "chestsnapping.stackNew", "args": { "prefab": "piece_chest_wood", "onPrefab": "piece_chest_wood", "index": 0 }, "expect": "placed", "label": "stacking on: chest placed on chest A" },
    { "do": "wait", "seconds": 10 },
    { "do": "hook", "name": "chestsnapping.stackedExists", "expect": true, "label": "the stacked chest is still there after 10 s of support checks" },
    { "do": "hook", "name": "chestsnapping.stackedSupported", "expect": true, "label": "and it has building support" },
    { "do": "setConfig", "values": { "General/Enable Stacking": false } },
    { "do": "wait", "until": { "check": "hook", "name": "chestsnapping.featureRunning", "args": { "id": "stacking" }, "expect": false }, "timeout": 5 },
    { "do": "hook", "name": "chestsnapping.stackNew", "args": { "prefab": "piece_chest_wood", "onPrefab": "piece_chest_wood", "index": 1 }, "expect": "placed", "label": "stacking off: chest placed on chest B (control)" },
    { "do": "wait", "until": { "check": "hook", "name": "chestsnapping.stackedExists", "expect": false }, "timeout": 40 }
  ],
  "asserts": [
    { "check": "noErrors", "source": "ChestSnapping" }
  ]
}
