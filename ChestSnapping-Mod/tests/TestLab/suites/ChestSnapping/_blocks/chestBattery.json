{
  "params": {
    "prefab": null,
    "turn": 1
  },
  "steps": [
    {
      "do": "hook",
      "name": "chestsnapping.placedClear",
      "label": "{{prefab}}: no chests left from an earlier test"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -4,
      "dz": 6,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -2,
      "dz": 6,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 0,
      "dz": 6,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 2,
      "dz": 6,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -4,
      "dz": 8,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -2,
      "dz": 8,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 0,
      "dz": 8,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 2,
      "dz": 8,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -4,
      "dz": 4,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -2,
      "dz": 4,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 0,
      "dz": 4,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 2,
      "dz": 4,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -4,
      "dz": 2,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": -2,
      "dz": 2,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 0,
      "dz": 2,
      "owner": "me"
    },
    {
      "do": "spawn",
      "prefab": "wood_floor",
      "dx": 2,
      "dz": 2,
      "owner": "me"
    },
    {
      "do": "hook",
      "name": "chestsnapping.liftPieces",
      "args": {
        "prefab": "wood_floor",
        "above": 0.3
      },
      "contains": "levelled 1",
      "label": "{{prefab}}: all floors level, 0.3 m above the highest ground (terrain noise must not decide a result)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.source",
      "args": {
        "prefab": "{{prefab}}"
      },
      "expect": "default",
      "label": "{{prefab}} is a known chest"
    },
    {
      "do": "hook",
      "name": "chestsnapping.stackNew",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "wood_floor",
        "index": 8
      },
      "expect": "placed",
      "label": "{{prefab}}: base chest on the floor (#0)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.stackNew",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "index": 0,
        "onIndex": 0
      },
      "expect": "placed",
      "label": "{{prefab}}: 2nd chest of the stack (#1)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.stackNew",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "index": 0,
        "onIndex": 1
      },
      "expect": "placed",
      "label": "{{prefab}}: 3rd chest of the stack (#2)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.snapPlacement",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "ghostPoint": 3,
        "targetPoint": 2,
        "rotation": 0,
        "onIndex": 0,
        "place": true
      },
      "contains": "PLACED as #3",
      "label": "{{prefab}}: 2nd chest side by side, aligned (#3)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.snapPlacement",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "ghostPoint": 3,
        "targetPoint": 2,
        "rotation": "{{turn}}",
        "onIndex": 3,
        "place": true
      },
      "contains": "PLACED as #4",
      "label": "{{prefab}}: 3rd chest side by side, ghost turned 22.5 degrees (#4)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.snapPlacement",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "ghostPoint": 0,
        "targetPoint": 1,
        "rotation": 8,
        "onIndex": 0,
        "place": true
      },
      "contains": "PLACED as #5",
      "label": "{{prefab}}: front to front, ghost turned 180 degrees (#5)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.snapPlacement",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "ghostPoint": 0,
        "targetPoint": 2,
        "rotation": 0,
        "onIndex": 0,
        "place": true
      },
      "contains": "PLACED as #6",
      "label": "{{prefab}}: row of 3 front to back - 2nd chest behind the first (#6)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.snapPlacement",
      "args": {
        "prefab": "{{prefab}}",
        "onPrefab": "{{prefab}}",
        "ghostPoint": 0,
        "targetPoint": 2,
        "rotation": 0,
        "onIndex": 6,
        "place": true
      },
      "contains": "PLACED as #7",
      "label": "{{prefab}}: row of 3 front to back - 3rd chest behind the 2nd (#7)"
    },
    {
      "do": "wait",
      "seconds": 10
    },
    {
      "do": "hook",
      "name": "chestsnapping.placedLayout",
      "contains": "layout ok",
      "label": "{{prefab}}: neat layout - stacked straight, side by side level and in line, row in line, everything rests on something"
    },
    {
      "do": "hook",
      "name": "chestsnapping.placedVisibleOverlap",
      "contains": "max overlap 0.0",
      "label": "{{prefab}}: the chests you SEE do not go into each other (visible meshes overlap under 0.1 m)"
    },
    {
      "do": "hook",
      "name": "chestsnapping.placedStatus",
      "expect": "8 placed, 8 alive, 8 supported",
      "label": "{{prefab}}: all eight still there with building support"
    },
    {
      "do": "hook",
      "name": "chestsnapping.placedClear",
      "label": "{{prefab}}: clean up"
    }
  ]
}